{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eduscope.local/schemas/device-manifest.schema.json",
  "title": "Eduscope device manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "image", "board", "capture", "audio", "displays", "touch", "hdmiPassthrough", "storage", "network", "led", "integrations", "chromium"],
  "properties": {
    "schemaVersion": {"const": 1},
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "sourceUrl", "sha256", "osId", "osVersion", "architecture", "kernelRelease"],
      "properties": {
        "name": {"type": ["string", "null"], "minLength": 1},
        "sourceUrl": {"type": ["string", "null"], "format": "uri", "pattern": "^https://"},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"},
        "osId": {"type": "string", "minLength": 1},
        "osVersion": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "kernelRelease": {"type": "string", "minLength": 1}
      }
    },
    "board": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "serial", "memoryBytes"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "serial": {"type": "string", "minLength": 1},
        "memoryBytes": {"type": "integer", "minimum": 1}
      }
    },
    "capture": {
      "type": "object", "additionalProperties": false,
      "required": ["vid", "pid", "serial", "usbPortPath", "videoByPath", "v4lIndex", "hubLocation", "hubPort"],
      "properties": {
        "vid": {"type": "string", "pattern": "^[0-9a-fA-F]{4}$"},
        "pid": {"type": "string", "pattern": "^[0-9a-fA-F]{4}$"},
        "serial": {"type": ["string", "null"], "minLength": 1},
        "usbPortPath": {"type": "string", "minLength": 1},
        "videoByPath": {"type": "string", "pattern": "^/dev/v4l/by-path/[^/]+$"},
        "v4lIndex": {"type": "integer", "minimum": 0},
        "hubLocation": {"type": "string", "minLength": 1},
        "hubPort": {"type": "integer", "minimum": 1}
      }
    },
    "audio": {
      "type": "object", "additionalProperties": false,
      "required": ["micCardId", "micPcmDevice", "micControl", "hdmi2CardId", "hdmi2PcmDevice", "format", "rateHz", "channels"],
      "properties": {
        "micCardId": {"type": "string", "pattern": "^(?=.*[A-Za-z])[A-Za-z0-9_-]+$"},
        "micPcmDevice": {"type": "string", "minLength": 1},
        "micControl": {"type": "string", "minLength": 1},
        "hdmi2CardId": {"type": ["string", "null"], "pattern": "^(?=.*[A-Za-z])[A-Za-z0-9_-]+$"},
        "hdmi2PcmDevice": {"type": ["string", "null"], "minLength": 1},
        "format": {"const": "S16LE"},
        "rateHz": {"const": 48000},
        "channels": {"const": 2}
      }
    },
    "displays": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "edidSha256", "observedConnector", "mode", "width", "height", "refreshHz"],
        "properties": {
          "role": {"enum": ["projector", "meeting", "panel"]},
          "edidSha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"},
          "observedConnector": {"type": ["string", "null"], "minLength": 1},
          "mode": {"type": ["string", "null"], "minLength": 1},
          "width": {"type": ["integer", "null"], "minimum": 1},
          "height": {"type": ["integer", "null"], "minimum": 1},
          "refreshHz": {"type": ["number", "null"], "exclusiveMinimum": 0}
        },
        "allOf": [
          {
            "if": {"properties": {"role": {"const": "panel"}}, "required": ["role"]},
            "then": {
              "properties": {
                "width": {"enum": [1280, null]},
                "height": {"enum": [800, null]}
              }
            }
          }
        ]
      }
    },
    "touch": {
      "type": "object", "additionalProperties": false,
      "required": ["vid", "pid", "serial", "name"],
      "properties": {
        "vid": {"type": "string", "pattern": "^[0-9a-fA-F]{4}$"},
        "pid": {"type": "string", "pattern": "^[0-9a-fA-F]{4}$"},
        "serial": {"type": ["string", "null"], "minLength": 1},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "hdmiPassthrough": {
      "type": "object", "additionalProperties": false,
      "required": ["inputConnector", "outputConnector", "observedPath", "latencyMs"],
      "properties": {
        "inputConnector": {"type": ["string", "null"], "minLength": 1},
        "outputConnector": {"type": ["string", "null"], "minLength": 1},
        "observedPath": {"type": ["string", "null"], "minLength": 1},
        "latencyMs": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "storage": {
      "type": "object", "additionalProperties": false,
      "required": ["recordingsUuid", "filesystem", "minBytes"],
      "properties": {
        "recordingsUuid": {"type": ["string", "null"], "format": "uuid", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},
        "filesystem": {"const": "ext4"},
        "minBytes": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "network": {
      "type": "object", "additionalProperties": false,
      "required": ["wiredInterface"],
      "properties": {"wiredInterface": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"}}
    },
    "led": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["present", "reason"], "properties": {"present": {"const": false}, "reason": {"type": "string", "minLength": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["present", "sysfsName", "activeValue"], "properties": {"present": {"const": true}, "sysfsName": {"type": "string", "pattern": "^[^/]+$"}, "activeValue": {"type": "integer", "minimum": 0}}}
      ]
    },
    "integrations": {
      "type": "object", "additionalProperties": false,
      "required": ["hallCode", "titlePattern", "timezone", "ntpServers", "quizPublicOrigin", "llmEndpoint"],
      "properties": {
        "hallCode": {"type": "string", "pattern": "^F[0-9]{4}$"},
        "titlePattern": {"type": "string", "minLength": 1},
        "timezone": {"type": "string", "minLength": 1},
        "ntpServers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "hostname"}},
        "quizPublicOrigin": {"type": ["string", "null"], "format": "uri", "pattern": "^https://[^/]+/?$"},
        "llmEndpoint": {"type": ["string", "null"], "format": "uri", "pattern": "^https://"}
      }
    },
    "chromium": {
      "type": "object", "additionalProperties": false,
      "required": ["forceHardwareAcceleration"],
      "properties": {"forceHardwareAcceleration": {"const": false}}
    }
  }
}
