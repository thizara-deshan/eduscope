{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["internalBearer", "jwtSecret", "secretboxKey", "quizDeviceCredential"],
  "properties": {
    "internalBearer": {"type": "string", "minLength": 32},
    "jwtSecret": {"type": "string", "minLength": 32},
    "secretboxKey": {"type": "string", "minLength": 32},
    "quizDeviceCredential": {"type": ["string", "null"], "minLength": 32}
  }
}
