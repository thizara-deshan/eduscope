#!/usr/bin/env python3
"""A fake `curl` for A-15/A-16 bench-script tests. Reads/writes its state
from the directory named by $FAKE_PM_STATE. No real network I/O ever happens.
"""
from __future__ import annotations

import json
import os
import re
import sys
from pathlib import Path

STATE = Path(os.environ["FAKE_PM_STATE"])


def _step() -> int:
    step_file = STATE / "step"
    return int(step_file.read_text()) if step_file.exists() else 0


def _status_snapshot() -> dict:
    sequence = json.loads((STATE / "sequence.json").read_text())
    idx = min(_step(), len(sequence) - 1)
    return sequence[idx]


def _log(name: str, entry: dict) -> None:
    path = STATE / name
    with path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(entry) + "\n")


def _post_response(path: str, body: dict) -> tuple[int, dict]:
    """Returns (http_status, body) — most POSTs are the usual 202-accepted,
    but `/consumers/thumbnails/offer` (A16-RES ledger enforcement) mirrors
    the real service: 409 `encoder_budget_exceeded` when the ledger is
    already at capacity, 202 otherwise."""
    match = re.match(r"^/publishers/([a-z0-9]+)/(start|stop)$", path)
    if match:
        state = "starting" if match.group(2) == "start" else "stopping"
        return 202, {"publisherId": match.group(1), "state": state}

    if path == "/consumers/record":
        return 202, {"consumerId": STATE.joinpath("next_record_id").read_text().strip(), "state": "starting"}
    if path == "/consumers/live":
        return 202, {"consumerId": STATE.joinpath("next_live_id").read_text().strip(), "state": "starting"}
    if path == "/consumers/meeting":
        return 202, {"consumerId": STATE.joinpath("next_meeting_id").read_text().strip(), "state": "starting"}

    if path == "/consumers/thumbnails/offer":
        snapshot = _status_snapshot()
        ledger = snapshot.get("encodeLedger", {})
        if ledger.get("inUse", 0) >= ledger.get("capacity", 0):
            return 409, {"code": "encoder_budget_exceeded", "title": "No free encode session", "status": 409}
        return 202, {"consumerId": "thumbnails:a16probe", "state": "starting"}

    if re.match(r"^/consumers/.+/stop$", path):
        return 202, {"state": "stopping"}

    return 200, {}


def main() -> int:
    args = sys.argv[1:]
    method = "GET"
    body = None
    url = None
    out_path: str | None = None
    write_fmt: str | None = None
    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "-X":
            method = args[i + 1]
            i += 1
        elif arg == "-d":
            body = json.loads(args[i + 1])
            i += 1
        elif arg == "-o":
            out_path = args[i + 1]
            i += 1
        elif arg == "-w":
            write_fmt = args[i + 1]
            i += 1
        elif arg in ("-H", "--max-time"):
            i += 1  # skip flag + its value
        elif arg.startswith("-"):
            pass  # ignore -f -s -S -N etc.
        else:
            url = arg
        i += 1

    if url is None:
        print("fake curl: no URL given", file=sys.stderr)
        return 1

    path = re.sub(r"^https?://[^/]+", "", url)

    fail_marker = STATE / "force_fail"
    if fail_marker.exists() and fail_marker.read_text().strip() in (path, "*"):
        print("fake curl: forced failure", file=sys.stderr)
        return 22

    if path == "/status" and method == "GET":
        status_code, response_body = 200, _status_snapshot()
    elif method == "POST":
        _log("posts.jsonl", {"path": path, "body": body})
        status_code, response_body = _post_response(path, body or {})
    else:
        status_code, response_body = 200, {}

    response_text = json.dumps(response_body)
    if out_path is not None:
        Path(out_path).write_text(response_text, encoding="utf-8")
    elif write_fmt is None:
        # No -o and no -w: default behavior (every pre-existing caller) —
        # print the body to stdout, same as always.
        print(response_text)

    if write_fmt is not None:
        # Only the one substitution the bench scripts actually use.
        sys.stdout.write(write_fmt.replace("%{http_code}", str(status_code)))

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
